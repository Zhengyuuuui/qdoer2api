[Unit]
Description=qoder2api CN (console 3588, bridge 8963)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/qoder2api
Environment=QODER2API_CONSOLE_PASSWORD=CHANGE_ME_CN
Environment=HOME=/root
ExecStart=/opt/qoder2api/qoder2api --instance=cn --bind=0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
